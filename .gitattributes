# The licence texts are checked byte for byte against the ones their
# projects publish (tools/bootstrap_text_fonts.py), so every checkout keeps
# them exactly as committed, line endings included, whatever its own
# line-ending settings.
/licenses/** -text

# The automation protocol's test frames are compared byte for byte, line
# feeds and carriage returns included, so no checkout changes their line
# endings.
/src/app/automation/tests/vectors/*.bin -text

# The registry specification's examples are signed: catalogue.json.sig covers
# catalogue.json's bytes, so no checkout changes their line endings.
/docs/registries/examples/** -text

# The pseudo language pack's files are read back byte for byte by the pack
# tests, its warm-up text included.
/src/data/languages/tests/pseudo-pack/** -text

# Classic's files are hashed byte for byte, so every checkout keeps them
# exactly as committed, line endings included.
/brains/classic/** -text
