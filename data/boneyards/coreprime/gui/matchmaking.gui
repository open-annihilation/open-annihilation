// The Matchmaking dialog over Chat or Battle: 150,140 and 340 by 250.
// Positions are relative to the panel. The glass, the choices, the queue,
// both faces and the opponent box are this file. ACTIVATE shows the
// searching face. The search is mocked: the opponent box is built and not
// opened. Close leaves a search running.
[GADGET0]
{
  [COMMON]
  {
    id=0;
    name=Matchmaking;
    xpos=150;
    ypos=140;
    width=340;
    height=250;
  }
  panel=Matchmaking;
  crdefault=Activate;
  escdefault=Close;
}
