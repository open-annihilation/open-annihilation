// Registration console. The panel is at its screen position. Every other
// gadget is relative to that panel, which is how a gadget file is read.
// The loader builds this screen. The panel draws no picture of its own, so
// the green console layer shows through it. The rule is the first child, and
// the font resources are the Hat faces. OPEN IN BROWSER is hidden where no
// browser can open, and the in-game row is hidden until that route is
// offered. The address is the build default.
[GADGET0]
{
  [COMMON]
  {
    id=0;
    name=Registration;
    xpos=23;
    ypos=126;
    width=498;
    height=313;
  }
  panel=Registration;
  escdefault=Back;
}
