// The Windows resources of oa-update.exe: the game's icon, version
// information that names it Open Annihilation Update, and, where the linker
// does not write one, its manifest. The manifest asks to run as the player
// who started it. CMake fills in the icon's path, the manifest's resource
// and the project's version.
#include <winver.h>

1 ICON "@OA_WINDOWS_ICON@"
@OA_UPDATE_MANIFEST_RESOURCE@

VS_VERSION_INFO VERSIONINFO
FILEVERSION @open_annihilation_VERSION_MAJOR@, @open_annihilation_VERSION_MINOR@, @open_annihilation_VERSION_PATCH@, 0
PRODUCTVERSION @open_annihilation_VERSION_MAJOR@, @open_annihilation_VERSION_MINOR@, @open_annihilation_VERSION_PATCH@, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // US English, Unicode.
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Open Annihilation Update"
            VALUE "FileVersion", "@open_annihilation_VERSION@"
            VALUE "InternalName", "oa-update"
            VALUE "ProductName", "Open Annihilation"
            VALUE "ProductVersion", "@open_annihilation_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
