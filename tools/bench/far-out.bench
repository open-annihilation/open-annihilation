# The battle from the farthest the view zooms out, the camera still, for 750 ticks.
label far-out
stage battle.stage
players 2
warmup_ticks 600
measure_seconds 150
measure_ticks 750
shot_at 12
shot_ticks 360
centre_x 1980
centre_z 2080
yaw 20
pitch -40
zoom 0
turn_rate 0
