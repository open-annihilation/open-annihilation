delay 0
reply {[Rover<S:command=quickplay_withdrawn><S:offer_id=a1b2c3d4e5f607><S:game_id=c0ffee0a11b223><I:reason=0>]}
reply {[Rover<S:command=quickplay_withdrawn><S:offer_id=a1b2c3d4e5f607><I:reason=3>]}
reply {[Rover<S:command=quickplay_withdrawn><S:offer_id=bbbbbbbbbbbbbb><S:game_id=c0ffee0a11b223><I:reason=2>]}
