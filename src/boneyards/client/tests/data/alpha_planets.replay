census 1816 6 0 0 0 0 0
census 1817 9 2 1 1 0 0
census 1818 1 0 0 0 0 0
census 1819 5 0 0 0 0 0
census 1820 13 1 0 1 0 0
activity 1010231010010020100102001

# SYNTHETIC: the locator's answer below was made up for the chat check
# (+locate Ghost_Commander).
located Ghost_Commander 1 7 3
located_field area_id uint 1801
located_field room_id uint 1
located_field area_name string Slag
located_field room_name string Main

# SYNTHETIC: the chat rooms of planet 1801 below were made up for the chat
# checks. Main is the only public (type 1) room, so the console's default
# pick enters it.
delay 1
# room AREA ROOM USERS TYPE NEEDS_PW NAME|DESCRIPTION|TAG
room 1801 1 4 1 0 Main|General chat
room 1801 2 2 2 0 Tactics|Build orders and strategy
room 1801 3 1 2 1 War_Room
entered 1801 1 0
entered 1801 2 0
# member AREA ROOM USER_ID LATENCY ICON RANK ALLEGIANCE NAME
member 1801 1 1 1 1 0 C oa_check
member 1801 1 7 2 8 0 C Ghost_Commander
member 1801 1 9 1 17 0 A Dan
member 1801 1 3 1 23 0 U Yard_Dog
# said AREA ROOM USER_ID TEXT
said 1801 1 3 Welcome to planet 1801, commanders.
said 1801 1 7 Anyone up for a 1v1?
said 1801 1 9 Sure, host it and I'll join.
