# QuickPlay replies. delay 0 is delivered in the pump that sent the command.
# `then` is delivered with the reply it follows. launch answers host_game and join_game,
# and is not taken by a quickplay command. A scan carries kind and names, never a sentence.
delay 0
reply {[Rover<S:command=quickplay_status><I:fits=1><I:meter=1><I:planets=25><I:queued=1><I:result=0>]}
then {[Rover<S:command=quickplay_scan><I:kind=1><S:planet=Altair><I:seq=1>]}
then {[Rover<S:battle=Rumble in the Rubble><S:command=quickplay_scan><I:game_type=1><I:kind=3><S:planet=Lava Alley><I:seats=1><I:seats_max=2><I:seq=2><I:skill=1>]}
then {[Rover<U:area_id=1a2><S:command=quickplay_found><S:game_id=c0ffee0a11b223><I:game_type=1><S:name=Rumble in the Rubble><S:offer_id=a1b2c3d4e5f607><S:planet=Lava Alley><I:role=0><I:skill=1>]}
reply {[Rover<S:command=quickplay_status><I:fits=1><I:meter=1><I:planets=25><I:queued=1><I:result=0>]}
launch {[Rover<S:command=launch_game><U:area_id=1a2><S:game_id=c0ffee0a11b223><S:address=127.0.0.1><S:password=QWERTY><S:session=c0ffee0a11b223><I:creator=0><I:result=0>]}
reply {[Rover<U:area_id=2><S:command=quickplay_found><I:game_type=1><S:name=ArmSniper><S:offer_id=a1b2c3d4e5f607><I:on_death=2><S:planet=Empyrrean><I:role=1><I:seats=2><I:skill=1>]}
reply {[Rover<S:command=quickplay_status><I:fits=0><I:meter=0><I:planets=25><I:queued=1><I:result=0>]}
launch {[Rover<S:command=launch_game><U:area_id=2><S:game_id=c0ffee0a11b223><S:address=127.0.0.1><S:password=QWERTY><S:session=c0ffee0a11b223><I:creator=1><I:result=0>]}
reply {[Rover<U:area_id=2><S:command=quickplay_found><S:game_id=c0ffee0a11b223><I:game_type=1><S:name=Rumble in the Rubble><S:offer_id=bbbbbbbbbbbbbb><S:planet=Lava Alley><I:role=0><I:skill=1>]}
reply {[Rover<S:command=quickplay_status><I:fits=1><I:meter=1><I:planets=25><I:queued=1><I:result=0>]}
reply {[Rover<S:command=quickplay_status><I:fits=0><I:meter=0><I:queued=0><I:result=0>]}
reply {[Rover<S:command=quickplay_status><I:fits=0><I:meter=0><I:planets=1><I:queued=1><I:result=0>]}
