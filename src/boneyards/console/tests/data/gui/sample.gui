// Sample screen. Every widget the loader builds, at absolute positions
// because the panel origin is 0,0. A list row joins the list above it.
[GADGET0]
{
  [COMMON]
  {
    id=0;
    name=Sample;
    xpos=0;
    ypos=0;
    width=640;
    height=480;
  }
  panel=Sample;
  crdefault=Go;
  escdefault=Spot;
}
[GADGET1]
{
  [COMMON]
  {
    id=20;
    name=Green;
    xpos=8;
    ypos=8;
    width=200;
    height=120;
  }
}
