# Writes a header that names the Classic fingerprint of SOURCE_DIR.
#
# The fingerprint is the SHA-256 of one line per file, in byte order of the
# path: "<sha256 of the file in lower-case hex> <path>\n". The installer's
# record .oa-origin.yaml is left out. A missing folder, or one with no other
# file, has an empty fingerprint, and then no package is Classic.
#
# SOURCE_DIR, OUTPUT and CONSTANT name the folder, the header and the
# constant the header declares.

if(NOT DEFINED SOURCE_DIR OR NOT DEFINED OUTPUT OR NOT DEFINED CONSTANT)
  message(FATAL_ERROR "classic_fingerprint.cmake needs SOURCE_DIR, OUTPUT and CONSTANT")
endif()

set(fingerprint "")
if(IS_DIRECTORY "${SOURCE_DIR}")
  file(GLOB_RECURSE listed LIST_DIRECTORIES false "${SOURCE_DIR}/*")
  set(paths "")
  foreach(file IN LISTS listed)
    file(RELATIVE_PATH relative "${SOURCE_DIR}" "${file}")
    string(REPLACE "\\" "/" relative "${relative}")
    if(relative STREQUAL ".oa-origin.yaml")
      continue()
    endif()
    list(APPEND paths "${relative}")
  endforeach()
  if(paths)
    list(SORT paths COMPARE STRING CASE SENSITIVE ORDER ASCENDING)
    set(text "")
    foreach(relative IN LISTS paths)
      file(SHA256 "${SOURCE_DIR}/${relative}" file_hash)
      string(TOLOWER "${file_hash}" file_hash)
      string(APPEND text "${file_hash} ${relative}\n")
    endforeach()
    string(SHA256 fingerprint "${text}")
    string(TOLOWER "${fingerprint}" fingerprint)
  endif()
endif()

get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${OUTPUT}"
"// Generated by src/sim/brains/classic_fingerprint.cmake. Do not edit.
#pragma once

namespace oa::sim::brains {

inline constexpr char ${CONSTANT}[] = \"${fingerprint}\";

}
")
