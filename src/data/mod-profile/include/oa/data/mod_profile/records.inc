    std::string weapons_not_to_underwater{};
    /// weapons.no-map-alert (weapon files): Weapon TDF key nomapweaponalert=1: an ownerless
    /// projectile whose [DAMAGE] default is 0 skips the area explosion and draws no minimap weapon
    /// alert.
    std::string weapons_no_map_alert{};
    /// veterancy.thresholds (unit files): FBI key VeterancyThresholds: ascending kill counts for
    /// each veterancy level of this unit type.
    std::string veterancy_thresholds{};
    /// veterancy.accuracy-rate (unit files): FBI key VeterancyAccuracyBuffRate: kills per unit of
    /// ballistic spread reduction (0 = no accuracy buff).
    std::string veterancy_accuracy_rate{};
    /// units.build-facings (unit files): FBI key Rotations: facings (letters from S E N W) a
