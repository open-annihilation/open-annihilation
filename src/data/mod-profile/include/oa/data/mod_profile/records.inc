/// The key a mod's files spell each data-key meaning with; empty when the profile binds none.
struct DataKeyBindings {
    /// weapons.not-to-air (weapon files): Weapon TDF key nottoair=1: the weapon may not target
    /// airborne units.
    std::string weapons_not_to_air{};
