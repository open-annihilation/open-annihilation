# The add_test wrapper. A separate file so this body is parsed as its own
# command, not expanded while another command is being defined.
#
# A function, not a macro: a macro rejoins every argument on semicolons, so a
# quoted path list such as -DDESTINATIONS=one;two becomes two arguments and
# the later destinations never receive the language fixture. ARGV${n} keeps
# each argument whole, and the original add_test is called with bracket
# arguments so those semicolons stay inside one argument.

# Quotes one argument for cmake_language, semicolons included.
function(_oa_bracket_argument value out_var)
  set(oa_n 0)
  while(TRUE)
    string(REPEAT "=" ${oa_n} oa_eq)
    set(oa_close "]${oa_eq}]")
    string(FIND "${value}" "${oa_close}" oa_at)
    if(oa_at EQUAL -1)
      set("${out_var}" "[${oa_eq}[${value}${oa_close}" PARENT_SCOPE)
      return()
    endif()
    math(EXPR oa_n "${oa_n} + 1")
  endwhile()
endfunction()

function(add_test)
  set(_oa_suffix "")
  set(_oa_rewrite FALSE)
  set(_oa_new_count 0)
  if(ARGC GREATER 2 AND ARGV0 STREQUAL "NAME")
    set(_oa_name "${ARGV1}")
    set(_oa_cmd "")
    set(_oa_in_cmd FALSE)
    set(_oa_stop FALSE)
    math(EXPR _oa_last "${ARGC} - 1")
    foreach(_oa_i RANGE 0 ${_oa_last})
      set(_oa_word "${ARGV${_oa_i}}")
      if(NOT _oa_in_cmd)
        if(_oa_word STREQUAL "COMMAND")
          set(_oa_in_cmd TRUE)
        endif()
      elseif(NOT _oa_stop)
        if(_oa_word STREQUAL "CONFIGURATIONS"
            OR _oa_word STREQUAL "WORKING_DIRECTORY"
            OR _oa_word STREQUAL "COMMAND_EXPAND_LISTS")
          set(_oa_stop TRUE)
        else()
          # Keep a semicolon inside this one command word.
          string(REPLACE ";" "\\;" _oa_word "${_oa_word}")
          list(APPEND _oa_cmd "${_oa_word}")
        endif()
      endif()
    endforeach()
    # A fixture that runs cmake -E rm on a preferences file would put the
    # game back on its defaults. Register the restore script instead: it
    # removes the same paths and copies each .conf from its seed.
    list(LENGTH _oa_cmd _oa_cmd_n)
    if(_oa_cmd_n GREATER 2)
      list(GET _oa_cmd 0 _oa_exe)
      list(GET _oa_cmd 1 _oa_dash_e)
      list(GET _oa_cmd 2 _oa_rm)
      string(REPLACE "\\;" ";" _oa_exe "${_oa_exe}")
      cmake_path(GET _oa_exe FILENAME _oa_base)
      if((_oa_base STREQUAL "cmake" OR _oa_base STREQUAL "cmake.exe")
          AND _oa_dash_e STREQUAL "-E" AND _oa_rm STREQUAL "rm")
        set(_oa_removals "")
        set(_oa_restores "")
        set(_oa_has_conf FALSE)
        foreach(_oa_arg IN LISTS _oa_cmd)
          string(REPLACE "\\;" ";" _oa_arg "${_oa_arg}")
          if(_oa_arg MATCHES "^-")
            continue()
          endif()
          if(_oa_arg STREQUAL "${_oa_exe}" OR _oa_arg STREQUAL "rm")
            continue()
          endif()
          list(APPEND _oa_removals "${_oa_arg}")
          if(_oa_arg MATCHES "\\.conf$")
            set(_oa_has_conf TRUE)
            list(APPEND _oa_restores "${_oa_arg}|${_oa_arg}.offline-seed")
          endif()
        endforeach()
        if(_oa_has_conf)
          set(_oa_rewrite TRUE)
          list(JOIN _oa_removals ";" _oa_removals_s)
          list(JOIN _oa_restores ";" _oa_restores_s)
          set("_oa_new_0" "${CMAKE_COMMAND}")
          set("_oa_new_1" "-DREMOVALS=${_oa_removals_s}")
          set("_oa_new_2" "-DRESTORES=${_oa_restores_s}")
          set("_oa_new_3" "-P")
          set("_oa_new_4" "${CMAKE_BINARY_DIR}/offline-preferences/restore-preferences.cmake")
          set(_oa_new_count 5)
        endif()
      endif()
    endif()
    oa_offline_suffix("${_oa_name}" "${_oa_cmd}" _oa_prefs _oa_data)
    if(_oa_prefs)
      list(APPEND _oa_suffix "--preferences-file" "${_oa_prefs}")
    endif()
    if(_oa_data)
      list(APPEND _oa_suffix "--data-dir" "${_oa_data}")
    endif()
  endif()
  set(_oa_code "_add_test(")
  set(_oa_emit_cmd TRUE)
  set(_oa_in_cmd FALSE)
  set(_oa_suffix_done FALSE)
  math(EXPR _oa_last "${ARGC} - 1")
  foreach(_oa_i RANGE 0 ${_oa_last})
    set(_oa_word "${ARGV${_oa_i}}")
    if(_oa_rewrite AND _oa_in_cmd AND _oa_emit_cmd)
      if(_oa_word STREQUAL "CONFIGURATIONS"
          OR _oa_word STREQUAL "WORKING_DIRECTORY"
          OR _oa_word STREQUAL "COMMAND_EXPAND_LISTS")
        set(_oa_emit_cmd FALSE)
        math(EXPR _oa_new_last "${_oa_new_count} - 1")
        foreach(_oa_n RANGE 0 ${_oa_new_last})
          _oa_bracket_argument("${_oa_new_${_oa_n}}" _oa_quoted)
          string(APPEND _oa_code " ${_oa_quoted}")
        endforeach()
        foreach(_oa_extra IN LISTS _oa_suffix)
          _oa_bracket_argument("${_oa_extra}" _oa_quoted)
          string(APPEND _oa_code " ${_oa_quoted}")
        endforeach()
        set(_oa_suffix_done TRUE)
      else()
        # Drop the original rm words. The restore script replaces them.
        continue()
      endif()
    endif()
    _oa_bracket_argument("${_oa_word}" _oa_quoted)
    string(APPEND _oa_code " ${_oa_quoted}")
    if(_oa_word STREQUAL "COMMAND")
      set(_oa_in_cmd TRUE)
    endif()
  endforeach()
  if(_oa_rewrite AND NOT _oa_suffix_done)
    math(EXPR _oa_new_last "${_oa_new_count} - 1")
    foreach(_oa_n RANGE 0 ${_oa_new_last})
      _oa_bracket_argument("${_oa_new_${_oa_n}}" _oa_quoted)
      string(APPEND _oa_code " ${_oa_quoted}")
    endforeach()
  endif()
  if(NOT _oa_suffix_done)
    foreach(_oa_extra IN LISTS _oa_suffix)
      _oa_bracket_argument("${_oa_extra}" _oa_quoted)
      string(APPEND _oa_code " ${_oa_quoted}")
    endforeach()
  endif()
  string(APPEND _oa_code ")")
  cmake_language(EVAL CODE "${_oa_code}")
endfunction()
