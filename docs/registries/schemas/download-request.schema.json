{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-annihilation/open-annihilation/main/docs/registries/schemas/download-request.schema.json",
  "title": "Download key request",
  "description": "POST <api>/downloads. install is present only when the registry's install-id is required. Unknown members are ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["package", "kind", "release", "sha256", "engine", "platform", "arch", "language", "reason"],
  "properties": {
    "install": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "package": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "minLength": 1, "maxLength": 64 },
    "kind": { "enum": ["oamod", "oamap", "oalang", "expansion", "oamut", "oabrain"] },
    "release": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "engine": { "type": "string", "pattern": "^[0-9A-Za-z.+-]+$", "minLength": 1, "maxLength": 32 },
    "platform": { "type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 1, "maxLength": 16 },
    "arch": { "type": "string", "pattern": "^[a-z0-9_]+$", "minLength": 1, "maxLength": 16 },
    "language": { "type": "string", "pattern": "^$|^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8}){0,3}$" },
    "reason": { "enum": ["install", "update", "repair", "offered-in-lobby", "mirror"] }
  }
}
