[Snap override]
	{
	de=Ohne Ausrichten;
	fr=Sans aimantation;
	es=Sin ajuste;
	it=Senza aggancio;
	}

[Held: no mex or wreck snap, and drag queued orders]
	{
	de=Gehalten: kein Einschnappen an Metallfeldern oder Wracks, und geplante Befehle ziehen;
	fr=Maintenu : pas d'aimantation aux gisements ni aux épaves, et glisser les ordres en file;
	es=Mantenido: sin ajuste a yacimientos ni restos, y arrastrar órdenes en cola;
	it=Tenuto: niente aggancio a giacimenti o relitti, e trascina gli ordini in coda;
	}

